# myphotos local config (test_lib on virtiofs)
DATA_ROOT=/mnt/mediafs/test_lib
ORIGINALS_DIR=/mnt/mediafs/test_lib/originals
DERIVED_DIR=/mnt/mediafs/test_lib/derived
TEMP_DIR=/mnt/mediafs/test_lib/temp

DB_URL=postgresql+psycopg://myphotos:myphotos@localhost:5432/myphotos
REDIS_URL=redis://localhost:6379/0

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# WebAuthn must use localhost as RP ID for local/tunneled access
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8000

# Serve built frontend from API
FRONTEND_DIST_DIR=../frontend/dist

# libvips dynamic modules need VIPSHOME set on this VM (otherwise it searches /target/...)
VIPSHOME=/usr
